#  DATA LOADING  — metadata.jsonl → pandas DataFrame

def safe_parse_regions(raw) -> List[Dict]:
    """
    Safely parse a regions field that may be a list, JSON string,
    Python literal string, or NaN/None. Never raises.
    """
    if raw is None:
        return []
    try:
        if pd.isna(raw):
            return []
    except (TypeError, ValueError):
        pass
    if isinstance(raw, list):
        return raw
    if raw in ("", "[]"):
        return []
    try:
        return json.loads(raw)
    except (json.JSONDecodeError, TypeError):
        pass
    try:
        return ast.literal_eval(raw)
    except Exception:
        return []


def load_metadata(meta_path: Path, img_dir: Path, split: str) -> pd.DataFrame:
    """
    Load a metadata.jsonl file into a DataFrame.

    Each line in metadata.jsonl is a JSON object. Common fields:
        file_name   — image filename  (e.g. "images/abc123.jpg")
        regions     — list of region dicts (train only)
        + any other metadata fields

    We normalise everything into the columns used by the rest of
    the pipeline: image, img_path, regions_parsed, n_regions.
    """
    records = []
    with open(meta_path, "r", encoding="utf-8") as f:
        for line in f:
            line = line.strip()
            if not line:
                continue
            try:
                records.append(json.loads(line))
            except json.JSONDecodeError:
                continue

    df = pd.DataFrame(records)
    print(f"\n[{split.upper()}]  raw shape={df.shape}")
    print(f"  Columns : {list(df.columns)}")
    print(df.head(3).to_string(index=False))

    # ── Normalise the image filename column ───────────────────────────────────
    # HuggingFace metadata.jsonl uses 'file_name' which may include
    # a leading "images/" prefix — strip it to get a bare filename.
    if "file_name" in df.columns:
        df["image"] = df["file_name"].apply(
            lambda x: Path(str(x)).name   # "images/abc.jpg" → "abc.jpg"
        )
    elif "image" not in df.columns:
        # Fallback: use the first column
        df["image"] = df.iloc[:, 0].apply(lambda x: Path(str(x)).name)

    # ── Resolve full image path on disk ───────────────────────────────────────
    def _resolve(fname):
        p = img_dir / fname
        return str(p) if p.exists() else None

    df["img_path"] = df["image"].apply(_resolve)
    found   = df["img_path"].notna().sum()
    missing = df["img_path"].isna().sum()
    print(f"  Images found : {found:,}  |  missing : {missing:,}")

    # ── Parse regions (train has them; test does not) ─────────────────────────
    if "regions" in df.columns:
        df["regions_parsed"] = df["regions"].apply(safe_parse_regions)
    else:
        df["regions_parsed"] = [[] for _ in range(len(df))]

    df["n_regions"] = df["regions_parsed"].apply(len)
    return df


