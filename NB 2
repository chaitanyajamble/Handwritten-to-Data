# ── FIGURE 3: Sample Annotated Images ────────────────────────
def show_annotated_samples(train_df, train_dir, n=6):
    """Display sample images with bounding box overlays."""
    annotated = train_df[train_df["regions_parsed"].apply(lambda x: len(x) > 0)]
    samples = annotated.sample(min(n, len(annotated)), random_state=42) if len(annotated) >= 1 else annotated

    TYPE_COLORS = {
        "handwritten": "#FF0000", "printed": "#0000FF", "formula": "#00AA00",
        "table": "#FF8C00",       "annotation": "#AA00FF", "image": "#00AAAA",
        "graph": "#FF00FF",       "unknown": "#888888",
    }

    fig3, axes3 = plt.subplots(2, 3, figsize=(21, 14))
    fig3.suptitle("Sample Annotated Images with Bounding Boxes", fontsize=16, fontweight="bold")
    axes3 = axes3.flatten()

    for ax in axes3:
        ax.axis("off")

    for idx, (_, row) in enumerate(samples.iterrows()):
        if idx >= len(axes3):
            break
        img_name = row.get("image", row.iloc[0])
        img_path = train_dir / img_name
        if not img_path.exists():
            axes3[idx].text(0.5, 0.5, f"Image not found:\n{img_name}",
                            ha="center", va="center", transform=axes3[idx].transAxes, fontsize=9)
            continue
        try:
            img = Image.open(img_path).convert("RGB")
            img_arr = np.array(img)
            axes3[idx].imshow(img_arr)
            axes3[idx].set_title(img_name[:40], fontsize=8, fontweight="bold")
            for reg in row["regions_parsed"]:
                if not isinstance(reg, dict):
                    continue
                bbox = reg.get("bbox", [])
                rtype = reg.get("type", "unknown")
                text  = str(reg.get("text", ""))[:30]
                color = TYPE_COLORS.get(rtype, "#888888")
                if len(bbox) == 4:
                    x1, y1, x2, y2 = bbox
                    rect = patches.Rectangle((x1, y1), x2-x1, y2-y1,
                                             linewidth=2, edgecolor=color,
                                             facecolor="none", alpha=0.85)
                    axes3[idx].add_patch(rect)
                    axes3[idx].text(x1, max(y1-5, 0), rtype[:3],
                                    color=color, fontsize=6, fontweight="bold",
                                    bbox=dict(boxstyle="round,pad=0.1", facecolor="white", alpha=0.6))
        except Exception as e:
            axes3[idx].text(0.5, 0.5, f"Error: {str(e)[:50]}",
                            ha="center", va="center", transform=axes3[idx].transAxes, fontsize=8)

    # Legend
    legend_elements = [patches.Patch(facecolor="none", edgecolor=c, linewidth=2, label=t)
                       for t, c in TYPE_COLORS.items()]
    fig3.legend(handles=legend_elements, loc="lower center", ncol=4, fontsize=10,
                title="Region Types", title_fontsize=11,
                bbox_to_anchor=(0.5, 0.0))

    plt.tight_layout(rect=[0, 0.05, 1, 1])
    plt.savefig("eda_figure3_annotated_samples.png", dpi=130, bbox_inches="tight")
    plt.show()
    print("Figure 3 saved.")

show_annotated_samples(train_df, TRAIN_DIR, n=6)

# ── FIGURE 4: Bounding Box Analysis ──────────────────────────
if len(regions_df) > 0 and len(regions_df["bbox"].dropna()) > 0:
    bbox_data = regions_df[regions_df["bbox"].apply(lambda x: isinstance(x, list) and len(x) == 4)]
    bbox_data = bbox_data.copy()
    bbox_data["x1"]     = bbox_data["bbox"].apply(lambda b: b[0])
    bbox_data["y1"]     = bbox_data["bbox"].apply(lambda b: b[1])
    bbox_data["x2"]     = bbox_data["bbox"].apply(lambda b: b[2])
    bbox_data["y2"]     = bbox_data["bbox"].apply(lambda b: b[3])
    bbox_data["bw"]     = bbox_data["x2"] - bbox_data["x1"]
    bbox_data["bh"]     = bbox_data["y2"] - bbox_data["y1"]
    bbox_data["area"]   = bbox_data["bw"] * bbox_data["bh"]
    bbox_data["aspect"] = bbox_data["bw"] / (bbox_data["bh"] + 1e-6)

    fig4, axes4 = plt.subplots(2, 3, figsize=(20, 12))
    fig4.suptitle("Bounding Box Analysis", fontsize=16, fontweight="bold")

    safe_plot_hist(axes4[0, 0], bbox_data["bw"].clip(upper=2000),  "BBox Width",   "px", "#E91E63")
    safe_plot_hist(axes4[0, 1], bbox_data["bh"].clip(upper=1000),  "BBox Height",  "px", "#3F51B5")
    safe_plot_hist(axes4[0, 2], bbox_data["aspect"].clip(0, 30),   "BBox Aspect",  "W/H","#009688")

    # Area by type
    ax41 = axes4[1, 0]
    if "type" in bbox_data.columns:
        type_area = bbox_data.groupby("type")["area"].median().sort_values()
        ax41.barh(type_area.index, type_area.values,
                  color=plt.cm.Set2(np.linspace(0, 1, len(type_area))), edgecolor="black")
        ax41.set_title("Median BBox Area by Type", fontweight="bold")
        ax41.set_xlabel("Pixels²")

    # BBox scatter (x1, y1 origin positions)
    ax42 = axes4[1, 1]
    ax42.scatter(bbox_data["x1"].clip(upper=3000).values,
                 bbox_data["y1"].clip(upper=4000).values,
                 c="#FF5722", alpha=0.15, s=5)
    ax42.set_title("BBox Top-Left Origins", fontweight="bold")
    ax42.set_xlabel("x1 (px)")
    ax42.set_ylabel("y1 (px)")
    ax42.invert_yaxis()

    # Width vs Height scatter
    ax43 = axes4[1, 2]
    types_uniq = bbox_data["type"].unique() if "type" in bbox_data.columns else ["unknown"]
    cmap43 = plt.cm.tab10(np.linspace(0, 1, len(types_uniq)))
    for i, t in enumerate(types_uniq):
        sub = bbox_data[bbox_data["type"] == t] if "type" in bbox_data.columns else bbox_data
        ax43.scatter(sub["bw"].clip(upper=2000).values,
                     sub["bh"].clip(upper=1000).values,
                     c=[cmap43[i]], alpha=0.25, s=6, label=t)
    ax43.set_title("BBox Width vs Height", fontweight="bold")
    ax43.set_xlabel("Width (px)")
    ax43.set_ylabel("Height (px)")
    ax43.legend(fontsize=7, markerscale=3)

    plt.tight_layout()
    plt.savefig("eda_figure4_bbox_analysis.png", dpi=130, bbox_inches="tight")
    plt.show()
    print("Figure 4 saved.")
else:
