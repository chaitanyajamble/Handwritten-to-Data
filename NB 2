# ── FIGURE 2: Image-level Visual Analysis ───
def get_image_stats(img_dir, sample_n=200):
    """Collect image statistics: size, aspect ratio, brightness."""
    stats = []
    img_files = list(img_dir.glob("*.*")) if img_dir.exists() else []
    sample_files = random.sample(img_files, min(sample_n, len(img_files)))
    for f in sample_files:
        try:
            img = Image.open(f).convert("RGB")
            w, h = img.size
            arr = np.array(img)
            stats.append({
                "file":   f.name,
                "width":  w,
                "height": h,
                "aspect": w / h,
                "brightness": arr.mean(),
                "std":    arr.std(),
                "r_mean": arr[:, :, 0].mean(),
                "g_mean": arr[:, :, 1].mean(),
                "b_mean": arr[:, :, 2].mean(),
            })
        except Exception:
            continue
    return pd.DataFrame(stats)

