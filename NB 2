# ── Parse regions JSON column ─────────────────────────────────
def parse_regions(regions_str):
    """Safely parse JSON regions string."""
    if pd.isna(regions_str) or regions_str == "[]" or regions_str == "":
        return []
    try:
        if isinstance(regions_str, list):
            return regions_str
        return json.loads(regions_str)
    except Exception:
        return []

